# ── Vim plugins (managed by vim-plug) ────────────────────────────────────────
vim/.vim/plugged/

# ── Vim runtime artifacts ─────────────────────────────────────────────────────
vim/.vim/.netrwhist

# ── Neovim lockfile (optional: remove if you want to pin plugin versions) ─────
nvim/.config/nvim/lazy-lock.json

# ── Tmux plugins (managed by tpm) ─────────────────────────────────────────────
tmux/.tmux/plugins/

# ── Noctalia runtime / state ───────────────────────────────────────────────────
noctalia/.config/noctalia/plugins/*/notecards/
noctalia/.config/noctalia/plugins/*/pinned.json

# ── OS / editor junk ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~
*.swp
*.swo
