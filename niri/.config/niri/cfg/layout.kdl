layout {

    gaps 4
    center-focused-column "on-overflow"
    always-center-single-column

    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.75
    }

    default-column-width { }

    focus-ring {
        on
        width 2
    }

    border {
        off
    }

    shadow {
        off
    }

    struts {}
}
