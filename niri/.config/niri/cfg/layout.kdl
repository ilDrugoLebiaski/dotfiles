layout {

    gaps 6
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        on
        width 1
    }
    
    border {
        on
        width 2
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        draw-behind-window false
    }

    struts {}
}
